{
  "name": "pdfinder",
  "version": "0.0.0",
  "private": true,
  "description": "Experimental synthetic encrypted PDF extraction for Cloudflare Workers",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node scripts/test.mjs",
    "build": "node scripts/build.mjs",
    "test:parser": "node scripts/test-parser.mjs",
    "test:attachments": "node --test tests/attachment-api.test.mjs",
    "test:providers": "node --test tests/provider-attachments.test.mjs tests/gmail-raw-envelope.test.mjs tests/icloud-attachment-envelope.test.mjs",
    "test:mime": "node --test tests/gmail-mime.test.mjs tests/icloud-host-handoff.test.mjs",
    "test:mail-fixture": "node --test tests/synthetic-mail-fixture.test.mjs",
    "prepare:synthetic-mail": "node scripts/prepare-synthetic-mail.mjs",
    "demo:synthetic": "node scripts/demo-synthetic.mjs",
    "verify": "npm test && npm run test:parser && npm run test:attachments && npm run test:providers && npm run test:mime && npm run test:mail-fixture && npm run test:mail-verifier && npm run verify:synthetic-mail && npm run test:documents && npm run demo:documents && npm run test:mail-search && npm run demo:selected-mail && npm run test:profiles && npm run demo:profiles && npm run test:profile-storage && npm run demo:profile-restart && npm run test:host-query && npm run demo:host-query && npm run test:preview-evidence && npm run demo:preview-evidence && npm run test:host-http && npm run demo:host-http && npm run build",
    "test:mail-verifier": "node --test tests/synthetic-mail-verifier.test.mjs",
    "verify:synthetic-mail": "node scripts/verify-synthetic-mail.mjs",
    "test:documents": "node --test tests/bounded-document-search.test.mjs",
    "demo:documents": "node scripts/demo-document-search.mjs",
    "test:mail-search": "node --test tests/selected-mail-search.test.mjs",
    "demo:selected-mail": "node scripts/demo-selected-mail.mjs",
    "test:profiles": "node --test tests/synthetic-password-profiles.test.mjs",
    "demo:profiles": "node scripts/demo-profile-lifecycle.mjs",
    "test:profile-storage": "node --test tests/synthetic-file-profile-storage.test.mjs",
    "demo:profile-restart": "node scripts/demo-profile-restart.mjs",
    "test:host-query": "node --test tests/synthetic-host-query.test.mjs",
    "demo:host-query": "node scripts/demo-host-query.mjs",
    "test:preview-evidence": "node --test tests/preview-smoke-evidence.test.mjs",
    "demo:preview-evidence": "node scripts/demo-preview-evidence.mjs",
    "test:host-http": "node --test tests/synthetic-host-http.test.mjs",
    "demo:host-http": "node scripts/demo-host-http.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.0"
  }
}
